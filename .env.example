# Copy to .env at the repository root. Never commit actual credentials.
# Read by the local llm-proxy service only:
#   node services/llm-proxy/src/server.js --env .env
# The Vite dev server forwards /api/llm to that service and never sees these values.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash-1017
# Production: sudo python3 deploy/configure-llm-secret.py
