# Copy to .env at the repository root. Never commit actual credentials.
# Public model name (included in the browser bundle).
VITE_MODEL=qwen3.8-max

# Development proxy only; never use a VITE_ prefix for secrets.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Production: sudo python3 deploy/configure-llm-secret.py
