# Install to /etc/ai4s-llm-proxy/llm-proxy.env (directory 0700, file 0600) with:
#   sudo python3 deploy/configure-llm-secret.py
# The installer writes/rotates LLM_API_KEY and preserves the other lines below.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash-1017

# Optional tuning (defaults in parentheses):
# LLM_PROXY_PORT=3082
# LLM_PROXY_HOST=127.0.0.1
# LLM_PROXY_PER_IP_CONCURRENCY=3
# LLM_PROXY_GLOBAL_CONCURRENCY=24
# LLM_PROXY_PER_IP_HOURLY=120
# LLM_PROXY_MAX_MESSAGE_CHARS=8000
# LLM_PROXY_MAX_CONTEXT_CHARS=4000
#
# Anonymous-abuse controls (SRC #592591) — browser-bound login-free sessions:
# LLM_PROXY_ALLOWED_ORIGINS=https://aiphy.pku.edu.cn,http://localhost:5173,http://127.0.0.1:5173
# LLM_PROXY_SESSION_QUOTA=80          # messages per session cookie
# LLM_PROXY_SESSION_TTL_MS=86400000   # session lifetime (24h)
# LLM_PROXY_PER_IP_SESSIONS_HOURLY=20 # session issuances per IP per hour
# LLM_PROXY_GLOBAL_DAILY_QUOTA=6000   # served messages per UTC day, site-wide
#
# Set true only behind a gateway that forwards X-Forwarded-For:
# LLM_PROXY_TRUST_XFF=false
