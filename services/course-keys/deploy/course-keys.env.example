# Installed root:root 0600. Enrollment remains closed until SMTP + login tests pass.
COURSE_KEYS_ORIGIN=https://aiphy.pku.edu.cn
COURSE_KEYS_HOST=127.0.0.1
COURSE_KEYS_PORT=3081
COURSE_KEYS_DB=/var/lib/course-key-service/web/keys.sqlite3
COURSE_KEYS_IMPORTER_SOCKET=/run/course-keys-importer/importer.sock
COURSE_KEYS_ADMIN_EMAILS=gwlbgs523@pku.edu.cn
COURSE_KEYS_ENROLLMENT_OPEN=false
# Optional pilot: listed student IDs may enroll while the global flag stays false.
# They must still be active in the roster. Empty means fully closed. No wildcard.
COURSE_KEYS_ENROLLMENT_PILOT_IDS=
COURSE_KEYS_TRUST_PROXY=true
# Generate once; keep stable across restarts. Do not use the placeholder.
COURSE_KEYS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=physicsandai2026@163.com
SMTP_PASS=
# Runtime configuration; not an application-code constant.
SMTP_FROM=physicsandai2026@163.com
